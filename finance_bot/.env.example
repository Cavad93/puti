# Telegram Bot Token (получить у @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Claude API Key (получить на https://console.anthropic.com/)
CLAUDE_API_KEY=your_claude_api_key_here

# Telegram User IDs разрешенных пользователей (через запятую)
# Узнать свой ID можно у @userinfobot
ALLOWED_USER_IDS=123456789,987654321

# Путь к базе данных
DATABASE_PATH=finance_bot.db

# Часовой пояс для напоминаний
TIMEZONE=Europe/Moscow
